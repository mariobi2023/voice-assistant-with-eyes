# Copy this file to .env and fill in your values:   copy .env.example .env
# .env is never committed (it will hold secrets). Tunable thresholds live in app/config.py.

# Where the backend reads the camera stream (MediaMTX RTSP output).
RTSP_URL=rtsp://localhost:8554/cam

# PostgreSQL connection (role and database created by setup_database.sql).
# Replace YOUR_PASSWORD with the password you chose when running setup_database.sql.
DATABASE_URL=postgresql://assistant:YOUR_PASSWORD@localhost:5432/voice_assistant

# Gemini API key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_KEY

# Optional: override the Gemini model from config.py (see: python -m app.assistant --list-models)
# GEMINI_MODEL=gemini-3-flash-preview

# Optional: Ollama fallback server (default http://127.0.0.1:11434)
# OLLAMA_URL=http://127.0.0.1:11434

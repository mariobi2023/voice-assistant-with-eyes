# Copy this file to .env and change the IPs:   copy .env.example .env
# Restart "npm run dev" after editing .env (Vite reads it only at start).

# FastAPI backend (server/). Use the IP of the laptop running it, e.g. http://192.168.1.20:8000
VITE_BACKEND_URL=http://localhost:8000

# MediaMTX WHEP URL for the live video (same laptop, port 8889).
VITE_WHEP_URL=http://localhost:8889/cam/whep

# Optional: fake data instead of the backend (true / false). Default: false.
# VITE_USE_MOCK=true
